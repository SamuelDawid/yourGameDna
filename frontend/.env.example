# Skopiuj do .env.local i zmień tylko to, czego potrzebujesz (.env.local nie trafia do gita).
# Wartości poniżej są domyślne – bez pliku też zadziałają.

# npm run dev – adres BFF, do którego trafia całe /api
BFF_URL=http://localhost:8080

# npm run dev:services – frontend łączy się prosto z serwisami (bez BFF)
PLAYER_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082

# Port serwera deweloperskiego Vite
PORT=5173
